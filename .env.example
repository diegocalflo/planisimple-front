# Copia este archivo a .env.local (ignorado por Git) y ajusta los valores.

# Raíz de la API, sin /v1. Con los emuladores del backend:
VITE_API_URL=http://localhost:5001/demo-planisimple/southamerica-west1/api

# SDK web de Firebase, del mismo proyecto que el backend.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-planisimple.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-planisimple
VITE_FIREBASE_APP_ID=

# Solo local: emulador de Auth del backend. Déjalo vacío para usar Firebase real.
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
